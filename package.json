{
  "name": "forge-1122-launcher",
  "version": "0.2.4",
  "description": "Minimal launcher for Minecraft Forge 1.12.2",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win portable nsis"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.8.9",
    "minecraft-launcher-core": "^3.18.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.baranus.launcher",
    "productName": "Baranus Launcher",
    "publish": [
      {
        "provider": "github",
        "owner": "jangofett158-ops",
        "repo": "baranus-launcher"
      }
    ],
    "compression": "store",
    "files": [
      "src/**/*",
      "package.json",
      "!release*/**",
      "!final-build/**",
      "!with-mods/**",
      "!fixed-build/**",
      "!visual-build/**",
      "!download-fix/**",
      "!download-final/**",
      "!baranus-build/**",
      "!baranus-optifine/**",
      "!baranus-ui/**",
      "!baranus-rebuild/**",
      "!baranus-rebuild-final/**",
      "!baranus-install-fix/**",
      "!baranus-button-fix/**",
      "!baranus-launchwrapper-fix/**",
      "!baranus-ram/**",
      "!baranus-dependencies/**",
      "!baranus-combined/**",
      "!baranus-auto-update/**",
      "!baranus-test-release/**",
      "!baranus-v017/**",
      "!baranus-v018/**",
      "!baranus-v019/**",
      "!baranus-v020/**",
      "!baranus-v021/**",
      "!baranus-v022/**",
      "!baranus-v023/**",
      "!baranus-v024/**",
      "!dist/**",
      "!build*.log"
    ],
    "directories": {
      "output": "baranus-v024"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Baranus-Launcher.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Baranus-Launcher-Setup-${version}.exe"
    }
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "electron-winstaller@5.4.0": true
  }
}
